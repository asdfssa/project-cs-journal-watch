# deploy จริงต้องเป็น production — development จะข้าม rate limit ให้ IP ภายใน, cookie ไม่ secure, error แนบ debug.raw_message
NODE_ENV=development
PORT=3000
# ใน Docker compose DB_HOST/DB_PORT/PORT จะถูกทับเป็น db / 3306 / 3000 อัตโนมัติ
# ค่าด้านล่างใช้เมื่อรัน backend นอก Docker โดยต่อ MySQL container ผ่านพอร์ต 3310
DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=journal_watch_v2
# production ต้องสร้างใหม่ (backend ไม่ยอม start ถ้ายังเป็นค่านี้): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_jwt_secret_for_testing_only_do_not_use_in_production_at_all_seriously
JWT_EXPIRES_IN=2h
JWT_OTP_EXPIRES_IN=10m
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
MAIL_MODE=console
MAIL_FROM=journal-watch@msu.ac.th
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# บังคับ STARTTLS เมื่อ port ไม่ใช่ 465 (ค่าเริ่มต้น) — ตั้งเป็น false เฉพาะ relay ภายในที่ไม่รองรับ TLS
# SMTP_REQUIRE_TLS=false
CORS_ORIGIN=http://localhost:4200,https://journal.farmlnwza007.online
# CSP connect-src เพิ่มเติม (ค่าเริ่มต้น https://api.farmlnwza007.online) — ตั้งเป็นค่าว่างถ้า FE กับ API อยู่ origin เดียวกัน
# CSP_CONNECT_EXTRA=https://api.farmlnwza007.online
# รับได้หลาย origin คั่นด้วย , — frontend ใน container เดียวกันเป็น same-origin ไม่ต้องใส่
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# รับได้หลาย domain คั่นด้วย , เช่น "msu.ac.th,gmail.com" ตอน dev เพื่อทดสอบด้วย
# Google account ส่วนตัว — อย่าลืมตัด gmail.com ออกก่อน deploy จริง
GOOGLE_ALLOWED_DOMAIN=msu.ac.th
SCOPUS_API_KEY_1=your_scopus_api_key_here
SCOPUS_API_KEY_2=
SCOPUS_API_KEY_3=
SCOPUS_API_KEY_4=
SCOPUS_API_KEY_5=
SCOPUS_API_KEY_6=
SCOPUS_API_KEY_7=
SCOPUS_API_KEY_8=
SCOPUS_API_KEY_9=
SCOPUS_API_KEY_10=

SCRAPER_HEADLESS=false
# Chromium พร้อมกันสูงสุด / คิวรอสูงสุด (เกิน → 429 SCRAPER_BUSY)
SCRAPER_MAX_CONCURRENT=2
SCRAPER_MAX_QUEUE=10

# Cloudflare Turnstile secret key — เว้นว่าง = ปิด CAPTCHA (เปิดเมื่อ frontend รองรับ 428 CAPTCHA_REQUIRED แล้ว)
TURNSTILE_SECRET=
# ค้นวารสารได้กี่ request ต่อผู้ใช้ต่อ 5 นาทีก่อนต้องยืนยัน CAPTCHA (ค้น 1 ครั้ง ≈ 2 request)
CAPTCHA_FREE_REQUESTS=20

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_MS=604800000